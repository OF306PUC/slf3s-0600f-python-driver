# Copy to the environment file next to run.sh and edit per run.
# Values below: one run of the pump-flow study, campaign main (see manifests/).

# Manifest under manifests/, or "none" for a run outside any study
# (offset test, bench check): recorded as such, nothing validated.
MANIFEST=pump-flow-main.toml

# Condition and replicate — must match the manifest's [conditions] and [plan].
CONFIG=C0
EXPERIMENT_REP=rep_1

# Per-run fields required by the manifest. PUMP_LOT is LOTA, LOTB or LOTC.
# Every other field goes in META as space-separated key=value pairs.
PUMP_LOT=LOTA
META="sensor=SEN1 tanda=T01"
# FLUID defaults to the manifest's value (NaCl_300mL); set it only to override.
#FLUID=NaCl_300mL

# Logging host, free-form (recorded in the CSV header).
DEVICE_LOGGER_ID=pi8

# Maximum duration in hours. The run ends earlier when the infusion ends.
HOURS=96

# on: stop when the flow stays near zero (end of infusion).
# off: run the full HOURS — static tests such as the capped-sensor offset.
END_OF_INFUSION=on

# Serial device of the sensor cable (default /dev/ttyUSB0).
#DEVICE=/dev/ttyUSB0

# Readout is fixed at 20 ms (50 Hz) in core.SAMPLING_INTERVAL. Do not set
# SAMPLING_MS: any value other than 20 is rejected before launch.
